# === Exchange API Keys ===
BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Deribit (public endpoints only for Phase 0-1, no keys needed)
# DERIBIT_CLIENT_ID=
# DERIBIT_CLIENT_SECRET=

# === Bybit Testnet (Faz 5) ===
# Set BYBIT_TESTNET=true to use testnet WebSocket + REST endpoints.
# Get testnet API keys from: https://testnet.bybit.com/app/user/api-management
BYBIT_TESTNET=false
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# === InfluxDB ===
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=ofi-pro-dev-token
INFLUXDB_ORG=ofi
INFLUXDB_BUCKET=ofi_metrics

# === Trading Settings ===
TRADING_SYMBOLS=BTCUSDT
BASE_RISK_PCT=0.01
MAX_DAILY_LOSS_PCT=0.03
MAX_WEEKLY_LOSS_PCT=0.07
MAX_DAILY_TRADES=8
COOLDOWN_MINUTES=15

# === Paper Trading (Faz 5) ===
PAPER_TRADING=true
INITIAL_BALANCE=10000.0
# Log file for paper trade JSON records (relative to project root)
PAPER_LOG_FILE=logs/paper_trades.jsonl

