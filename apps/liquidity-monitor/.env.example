# Alchemy (free tier: https://www.alchemy.com)
ALCHEMY_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Telegram (create bot via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Thresholds
MIN_ETH_NEW_TOKEN=1
MIN_ETH_EXISTING_TOKEN=5

# Cooldown per token (ms) — default 12 hours
COOLDOWN_MS=43200000

# Max pair age to be "new" (seconds) — default 24 hours
NEW_TOKEN_MAX_AGE=86400

# ============================================================
# TRADING (leave TRADING_PRIVATE_KEY empty to disable trading)
# ============================================================

# Hot wallet private key (WITHOUT 0x prefix)
# NEVER use your main wallet! Create a dedicated trading wallet.
TRADING_PRIVATE_KEY=

# Position size: % of wallet balance per trade
TRADING_POSITION_PCT=50

# Max % of pool to buy/sell in one lot
TRADING_MAX_POOL_PCT=3

# Max slippage tolerance %
TRADING_SLIPPAGE_PCT=5

# Max gas price (gwei) — skip trade if higher
TRADING_MAX_GAS_GWEI=50

# Hold time before selling (ms) — default 10 minutes
TRADING_HOLD_TIME_MS=600000

# Stop-loss % from entry
TRADING_STOP_LOSS_PCT=15

# Max daily loss % before pausing
TRADING_MAX_DAILY_LOSS_PCT=30

# Consecutive losses before 1h pause
TRADING_MAX_CONSECUTIVE_LOSSES=3
